 stroke=\"currentColor\"\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    stroke-width=\"2\"\n                    class=\"w-10 h-10\"\n                    viewBox=\"0 0 24 24\"\n                  >\n                    <path d=\"M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2\"></path>\n                    <circle cx=\"12\" cy=\"7\" r=\"4\"></circle>\n                  </svg>\n                </div>\n                <div class=\"flex-grow\">\n                  <h2 class=\"text-gray-900 text-lg title-font font-medium mb-3\">\n                    Neptune\n                  </h2>\n                  <p class=\"leading-relaxed text-base\">\n                    Blue bottle crucifix vinyl post-ironic four dollar toast\n                    vegan taxidermy. Gastropub indxgo juice poutine, ramps\n                    microdosing banh mi pug VHS try-hard.\n                  </p>\n                  <a class=\"mt-3 text-pink-500 inline-flex items-center\">\n                    Learn More\n                    <svg\n                      fill=\"none\"\n                      stroke=\"currentColor\"\n                      stroke-linecap=\"round\"\n                      stroke-linejoin=\"round\"\n                      stroke-width=\"2\"\n                      class=\"w-4 h-4 ml-2\"\n                      viewBox=\"0 0 24 24\"\n                    >\n                      <path d=\"M5 12h14M12 5l7 7-7 7\"></path>\n                    </svg>\n                  </a>\n                </div>\n              </div>\n            </div>\n            {/* <button class=\"flex mx-auto mt-16 text-white bg-pink-500 border-0 py-2 px-8 focus:outline-none hover:bg-pink-600 rounded text-lg\">Button</button> */}\n          </div>\n        </section>\n\n        <section class=\"bg-white py-20\">\n          <div class=\"max-w-5xl px-6 mx-auto text-center\">\n            <h2 class=\"text-4xl font-semibold text-gray-800\">\n              Latest projects\n            </h2>\n\n            <div class=\"flex flex-wrap -m-4 bg-white-900\">\n              {projectData &&\n                projectData.map((project, index) => (\n                  <div class=\"p-4 md:w-1/3\">\n                    <div class=\"h-full border-2 border-gray-200 border-opacity-60 rounded-lg overflow-hidden\">\n                      <img\n                        class=\"lg:h-48 md:h-36 w-full object-cover object-center\"\n                        src={urlFor(project.projectImage)}\n                        alt=\"blog\"\n                      />\n                      <div class=\"p-6\">\n                        <h2 class=\"tracking-widest text-xs title-font font-medium text-gray-400 mb-1\">\n                          <strong className=\"font-bold text-gray-900\">\n                            Type\n                          </strong>\n                          : {project.projectType}\n                          <span>\n                            ||{\" \"}\n                            <strong className=\"font-bold text-gray-900\">\n                              place\n                            </strong>\n                            : {project.place}\n                          </span>\n                        </h2>\n                        <h1 class=\"title-font text-lg font-medium text-gray-900 mb-3\">\n                          <a\n                            href={project.link}\n                            alt={project.title}\n                            target=\"_blank\"\n                            rel=\"noopener noreferrer\"\n                          >\n                            {project.title}\n                          </a>\n                        </h1>\n                        <p class=\"leading-relaxed mb-3\">\n                          {project.description}\n                        </p>\n                        <div class=\"flex items-center flex-wrap \">\n                          <a class=\"text-pink-500 inline-flex items-center md:mb-2 lg:mb-0\">\n                            <a\n                              href={project.link}\n                              rel=\"noopener noreferrer\"\n                              target=\"_blank\"\n                              className=\"block font-medium text-purple-600\"\n                            >\n                              View More{\" \"}\n                              <span role=\"img\" aria-label=\"right pointer\">\n                                👉\n                              </span>\n                            </a>\n                          </a>\n                          <span class=\"text-gray-400 mr-3 inline-flex items-center lg:ml-auto md:ml-0 ml-auto leading-none text-sm pr-3 py-1 border-r-2 border-gray-200\">\n                            <strong className=\"font-bold text-gray-900\">\n                              Date\n                            </strong>\n                            : {new Date(project.date).toLocaleDateString()}\n                          </span>\n                        </div>\n                        {/* <span class=\"font-bold text-gray-900\">\n                {project. tags}\n                {project. tags2}\n                </span> */}\n                      </div>\n                    </div>\n                  </div>\n                ))}\n            </div>\n\n            <div class=\"flex items-center justify-center mt-12\">\n              <a\n                class=\"flex items-center text-gray-600 hover:underline hover:text-gray-500\"\n                href=\"/project\"\n              >\n                <span>View More</span>\n\n                <svg\n                  class=\"h-5 w-5 ml-1\"\n                  fill=\"none\"\n                  viewBox=\"0 0 24 24\"\n                  stroke=\"currentColor\"\n                >\n                  <path\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    stroke-width=\"2\"\n                    d=\"M17 8l4 4m0 0l-4 4m4-4H3\"\n                  />\n                </svg>\n              </a>\n            </div>\n          </div>\n        </section>\n\n        <section class=\"bg-gray-800 pattern py-20\">\n          <div class=\"max-w-5xl px-6 mx-auto text-center\">\n            <h2 class=\"text-2xl font-semibold text-white\">Latest BLog Posts</h2>\n            <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-8\">\n              {postData &&\n                postData.map((post, index) => (\n                  <article>\n                    <Link\n                      to={\"/post/\" + post.slug.current}\n                      key={post.slug.current}\n                    >\n                      <span\n                        className=\"block h-64 relative rounded shadow leading-snug bg-white border-l-8 border-green-400\"\n                        key={index}\n                      >\n                        <img\n                          src={post.mainImage.asset.url}\n                          alt={post.mainImage.alt}\n                          className=\"w-full h-full rounded-r object-cover absolute\"\n                        />\n                        <span className=\"block relative h-full flex justify-end items-end pr-4 pb-4\">\n                          <h3 className=\"text-gray-800 text-lg font-blog px-3 py-4 bg-red-700 text-red-100 bg-opacity-75 rounded\">\n                            {post.title}\n                          </h3>\n                        </span>\n                      </span>\n                    </Link>\n                  </article>\n                ))}\n            </div>\n            <div class=\"flex items-center justify-center mt-12\">\n              <a\n                class=\"flex items-center text-gray-600 hover:underline hover:text-gray-500\"\n                href=\"/post\"\n              >\n                <span>View More</span>\n                <svg\n                  class=\"h-5 w-5 ml-1\"\n                  fill=\"none\"\n                  viewBox=\"0 0 24 24\"\n                  stroke=\"currentColor\"\n                >\n                  <path\n                    stroke-linecap=\"round\"\n                    stroke-linejoin=\"round\"\n                    stroke-width=\"2\"\n                    d=\"M17 8l4 4m0 0l-4 4m4-4H3\"\n                  />\n                </svg>\n              </a>\n            </div>\n          </div>\n        </section>\n      </div>\n    </main>\n  );\n}\n","/Users/robinthakur/Documents/GitHub/-my-portfolio/src/components/Post.js",[],"/Users/robinthakur/Documents/GitHub/-my-portfolio/src/components/Project.js",["72","73","74","75"],"import React, { useEffect, useState } from \"react\";\nimport sanityClient from \"../client.js\";\nimport imageUrlBuilder from \"@sanity/image-url\";\nimport logo from '../assets/profile.png';\n\nconst builder = imageUrlBuilder(sanityClient);\nfunction urlFor(source) {\n  return builder.image(source);\n}\nexport default function Project() {\n  const [projectData, setProjectData] = useState(null);\n\n  useEffect(() => {\n    sanityClient\n      .fetch(\n        `*[_type == \"project\"]{\n          \"projectImage\": image.asset->url,\n          title,\n          date,\n          place,\n          description,\n          projectType,\n          link,\n          tags,\n          tags2\n      }`\n      )\n      .then((data) => setProjectData(data))\n      .catch(console.error);\n  }, []);\n\n  return (\n    <main className=\"bg-green-100 min-h-screen p-12 bg-white-900\">\n      <section className=\"container mx-auto\">\n        <h1 className=\"text-5xl flex justify-center \">My Projects</h1>\n        <h2 className=\"text-center font-bold text-2xl text-indigo-500\">\n          Welcome to my projects page!\n        </h2>\n\n        <section class=\"text-gray-600 body-font\">\n     \n      <div class=\"container px-5 py-24 mx-auto \">\n\n      <div class=\"flex flex-wrap -m-4 bg-dark-900\">\n      {projectData &&\n            projectData.map((project, index) => (\n        <div class=\"p-4 md:w-1/3\">\n              <div class=\"h-full border-2 border-gray-200 border-opacity-60 rounded-lg overflow-hidden\">\n            <img class=\"lg:h-48 md:h-36 w-full object-cover object-center\" \n            src={urlFor(project.projectImage)} \n            alt=\"blog\"/>\n            <div class=\"p-6\">\n              <h2 class=\"tracking-widest text-xs title-font font-medium text-gray-400 mb-1\">\n              <strong className=\"font-bold text-gray-900\">Type</strong>:{\" \"}\n                    {project.projectType}\n                    <span>\n                    || <strong className=\"font-bold text-gray-900\" >place</strong>:{\" \"}\n                    {project.place}\n                  </span>\n              </h2>\n              <h1 class=\"title-font text-lg font-medium text-gray-900 mb-3\"> \n              <a\n                    href={project.link}\n                    alt={project.title}\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                  >\n                    {project.title}\n                  </a>\n                  </h1>\n              <p class=\"leading-relaxed mb-3\">\n              {project.description}\n              </p>\n              <div class=\"flex items-center flex-wrap \">\n                <a class=\"text-pink-500 inline-flex items-center md:mb-2 lg:mb-0\">\n                <span class=\"text-gray-400 mr-3 inline-flex items-center lg:ml-auto md:ml-0 ml-auto leading-none text-sm pr-3 py-1 border-r-2 border-gray-200\">\n                <strong className=\"font-bold text-gray-900\">Date:{\" \"}</strong>\n                    {new Date(project.date).toLocaleDateString()}\n                </span>\n                <a\n                    href={project.link}\n                    rel=\"noopener noreferrer\"\n                    target=\"_blank\"\n                    className=\"block font-medium text-purple-600\"\n                  >\n                    View More{\" \"}\n                    <span role=\"img\" aria-label=\"right pointer\">\n                      👉\n                    </span>\n                  </a>\n                </a>\n\n               \n              </div>\n              <span class=\"font-bold text-gray-900\">\n                {project. tags}\n                {project. tags2}\n                </span>\n            </div>\n          </div>\n        </div>\n        ))}\n      </div>\n    </div>\n \n</section>\n        {/* <div class=\"grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 mt-6\">\n                    <div class=\"w-full max-w-sm mx-auto rounded-md shadow-md overflow-hidden\">\n                        <div class=\"flex items-end justify-end h-56 w-full bg-cover\" style=\"background-image: url('https://images.unsplash.com/photo-1563170351-be82bc888aa4?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=376&q=80')\">\n                            <button class=\"p-2 rounded-full bg-blue-600 text-white mx-5 -mb-4 hover:bg-blue-500 focus:outline-none focus:bg-blue-500\">\n                                <svg class=\"h-5 w-5\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path d=\"M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z\"></path></svg>\n                            </button>\n                        </div>\n                        <div class=\"px-5 py-3\">\n                            <h3 class=\"text-gray-700 uppercase\">Chanel</h3>\n                            <span class=\"text-gray-500 mt-2\">$12</span>\n                        </div>\n                    </div> */}\n                      {/* <div class=\"bg-white rounded-2xl shadow-xl px-8 py-12 sm:px-12 lg:px-8\">\n                <div class=\"mb-12 space-y-4\">\n                    <h3 class=\"text-2xl font-semibold text-purple-900\">UX Design</h3>\n                    <p class=\"mb-6\">Obcaecati, quam? Eligendi, nulla numquam natus laborum porro at cum, consectetur ullam tempora ipsa iste officia sed officiis! Incidunt ea animi officiis.</p>\n                    <a href=\"#\" class=\"block font-medium text-purple-600\">Know more</a>\n                </div> */}\n                {/* <img  src={urlFor(author.authorImage).url()} class=\"w-2/3 ml-auto \" alt=\"illustration\" loading=\"lazy\" width=\"900\" height=\"600\"/>\n            </div> */}\n        {/* <section className=\"grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 mt-6\">\n          {projectData &&\n            projectData.map((project, index) => (\n              <article className=\"relative rounded-lg shadow-xl bg-white p-16\">\n                <h3 className=\"text-2xl font-semibold text-purple-900\">\n                  <a\n                    href={project.link}\n                    alt={project.title}\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                  >\n                    {project.title}\n                  </a>\n                </h3>\n                <div className=\"text-gray-500 text-xs space-x-4\">\n                  <span>\n                    <strong className=\"font-bold\">Finished on</strong>:{\" \"}\n                    {new Date(project.date).toLocaleDateString()}\n                  </span>\n                  <span>\n                    <strong className=\"font-bold\">Company</strong>:{\" \"}\n                    {project.place}\n                  </span>\n                  <span>\n                    <strong className=\"font-bold\">Type</strong>:{\" \"}\n                    {project.projectType}\n                  </span>\n                  <p className=\"my-6 text-lg text-gray-700 leading-relaxed\">\n                    {project.description}\n                  </p>\n                  <a\n                    href={project.link}\n                    rel=\"noopener noreferrer\"\n                    target=\"_blank\"\n                    className=\"block font-medium text-purple-600\"\n                  >\n                    View The Project{\" \"}\n                    <span role=\"img\" aria-label=\"right pointer\">\n                      👉\n                    </span>\n                  </a>\n                </div>\n              </article>\n            ))}\n        </section> */}\n        {/* <div class=\"mt-16\">\n                <h3 class=\"text-gray-600 text-2xl font-medium\">More Products</h3>\n                <div class=\"grid gap-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 mt-6\">\n                    <div class=\"w-full max-w-sm mx-auto rounded-md shadow-md overflow-hidden\">\n                        <div class=\"flex items-end justify-end h-56 w-full bg-cover\" style=\"background-image: url('https://images.unsplash.com/photo-1563170351-be82bc888aa4?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=376&q=80')\">\n                            <button class=\"p-2 rounded-full bg-blue-600 text-white mx-5 -mb-4 hover:bg-blue-500 focus:outline-none focus:bg-blue-500\">\n                                <svg class=\"h-5 w-5\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path d=\"M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z\"></path></svg>\n                            </button>\n                        </div>\n                        <div class=\"px-5 py-3\">\n                            <h3 class=\"text-gray-700 uppercase\">Chanel</h3>\n                            <span class=\"text-gray-500 mt-2\">$12</span>\n                        </div>\n                    </div>\n                    <div class=\"w-full max-w-sm mx-auto rounded-md shadow-md overflow-hidden\">\n                        <div class=\"flex items-end justify-end h-56 w-full bg-cover\" style=\"background-image: url('https://images.unsplash.com/photo-1544441893-675973e31985?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=1500&q=80')\">\n                            <button class=\"p-2 rounded-full bg-blue-600 text-white mx-5 -mb-4 hover:bg-blue-500 focus:outline-none focus:bg-blue-500\">\n                                <svg class=\"h-5 w-5\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path d=\"M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z\"></path></svg>\n                            </button>\n                        </div>\n                        <div class=\"px-5 py-3\">\n                            <h3 class=\"text-gray-700 uppercase\">Man Mix</h3>\n                            <span class=\"text-gray-500 mt-2\">$12</span>\n                        </div>\n                    </div>\n                    <div class=\"w-full max-w-sm mx-auto rounded-md shadow-md overflow-hidden\">\n                        <div class=\"flex items-end justify-end h-56 w-full bg-cover\" style=\"background-image: url('https://images.unsplash.com/photo-1532667449560-72a95c8d381b?ixlib=rb-1.2.1&auto=format&fit=crop&w=750&q=80')\">\n                            <button class=\"p-2 rounded-full bg-blue-600 text-white mx-5 -mb-4 hover:bg-blue-500 focus:outline-none focus:bg-blue-500\">\n                                <svg class=\"h-5 w-5\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewBox=\"0 0 24 24\" stroke=\"currentColor\"><path d=\"M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z\"></path></svg>\n                   